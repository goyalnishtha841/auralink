# Auralink settings. Copy this file to `.env` (cp .env.example .env) and change what you need.
# scripts/run.sh and scripts/demo.sh read `.env` automatically. `.env` is never pushed to GitHub.
#
# Auralink needs NO passwords, accounts or API keys: there is no cloud service. It runs fully offline.
# The only secret is the crew PIN. Every other line is optional: leave it commented out (#) to keep
# the default shown.

# --- The one secret ---------------------------------------------------------------------------
# 6 digits the crew type once per device on the crew tablet, presenter console, flight report and
# Under the hood. Empty or missing: scripts/demo.sh picks a new random one each start and prints it.
# Keep one fixed PIN for all rehearsals. Never use the example from the README on stage.
AURALINK_CREW_PIN=

# --- Network ------------------------------------------------------------------------------------
# PORT=8000                 # unset: the first free port from 8000 up (8000 is often another app)
# HOST=0.0.0.0              # 0.0.0.0 = phones on the Wi-Fi can connect; 127.0.0.1 = this laptop only
# AURALINK_PUBLIC_URL=      # address printed in QR codes, e.g. https://192.168.1.20:8001 (default: found automatically)

# --- Speech -------------------------------------------------------------------------------------
# AURALINK_ASR_MODEL=base        # passenger requests: base (~0.7 s) or small (~2.9 s, more accurate)
# AURALINK_PA_ASR_MODEL=small    # crew announcements: small is needed for formal Japanese
# AURALINK_PRELOAD_ASR=1         # 1 = load Whisper at start, so the first request is not slow
# AURALINK_MATCHER=hybrid        # hybrid (best), phonetic, phonetic_uniform or text (for comparisons)
# PHONEMIZER_ESPEAK_LIBRARY=     # only if eSpeak-NG is installed somewhere unusual

# --- Demo behaviour -----------------------------------------------------------------------------
# AURALINK_CARE_AFTER_S=5400     # quiet large-text / pictures-only passengers get a check-in stop after
#                                # this many seconds; demo.sh uses 120 on stage
# AURALINK_FRESH=1               # 1 = ignore the saved cabin state and start empty

# --- Where data is kept (git-ignored folders) ---------------------------------------------------
# AURALINK_FLIGHT_DIR=data/flight          # cabin state for crash recovery, check-ins
# AURALINK_RECORDINGS_DIR=data/recordings  # volunteer voice recordings: back these up, they are not on GitHub
# AURALINK_CA_ROOT=                        # mkcert's folder, if not the default (see scripts/setup_https.sh)
